# Kratis Docker Compose Environment Variables
# Copy this file to .env and customize for your deployment

# Database Configuration
DB_USERNAME=kratis
DB_PASSWORD=kratis
# Host port mapping (only used if 'ports' is uncommented in compose.yaml)
DB_PORT=5432

# API Configuration
API_PORT=8080

# Group id of the host /var/run/docker.sock — the control plane spawns sandboxes
# through it as non-root via this group. install.sh detects this automatically;
# manual installs: stat -c %g /var/run/docker.sock (Linux), stat -f %g (macOS).
DOCKER_GID=0

# JWT Secret (must be at least 32 characters)
JWT_SECRET=change-me-in-production-this-must-be-at-least-32-chars

# ── Storage locations (optional) ──────────────────────────────────────────────
# Volumes default to Docker-managed named volumes. Uncomment one to bind it to a
# host directory instead (must be writable by uid/gid 1000).
#   KRATIS_DB_DIR=/srv/kratis/postgres
#   KRATIS_CONFIG_DIR=/srv/kratis/config
#   KRATIS_BLOBS_DIR=/srv/kratis/blobs
#   KRATIS_REGISTRY_DIR=/srv/kratis/registry

# LiteLLM Gateway Configuration
LITELLM_MASTER_KEY=sk-litellm-master-key-change-me
LITELLM_SALT_KEY=litellm-salt-key-change-me
LITELLM_PORT=4000

# ── GitHub App authentication (optional) ─────────────────────────────────────
# Disabled unless the App id and name are set. Put the PEM in the config volume
#   KRATIS_GITHUB_APP_ID=123456
#   KRATIS_GITHUB_APP_NAME=my-kratis-app
#   KRATIS_GITHUB_PRIVATE_KEY_PATH=/data/config/gh-app.pem

# ── Runtime container cap ──────────────────────────────────────────────────────
# mem_limit caps the running kratis container, NOT the build.
# The compiled native binary typically uses 256-512MB at runtime.
MEM_LIMIT=1g

# ── LiteLLM container cap ─────────────────────────────────────────────────────
# LiteLLM proxy memory limit (requires ~1.2GB during startup and Prisma migrations)
LITELLM_MEM_LIMIT=2g

# ── Usage telemetry ───────────────────────────────────────────────────────────
# Anonymous, aggregate-only usage statistics are reported once per day to PostHog
# (team/repo/job/execution counts and total LLM spend; no repo names, user data,
# or prompts). Telemetry is ON by default. Uncomment this line to disable.
#   KRATIS_TELEMETRY_DISABLED=1

# ── Harness definitions (optional) ────────────────────────────────────────────
# Built-ins ship at /opt/kratis/harnesses. Put your catalogue in the config volume
# at harnesses/ and point this at it to replace them.
#   KRATIS_HARNESSES_DIRECTORY=/data/config/harnesses
