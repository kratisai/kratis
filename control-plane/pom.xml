	<build>
		<!-- The LiteLLM patch script lives in deploy/ so the compose stack is self-contained for
		     remote installs; tests load it from the classpath (PostgresTestInitializer,
		     LiteLLMLoggingPatchTest). -->
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<testResource>
				<directory>${project.basedir}/../deploy</directory>
				<includes>
					<include>litellm/patch_response_logging.py</include>
				</includes>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Surefire for stack trace trimming -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.5</version>
				<configuration>
					<trimStackTrace>true</trimStackTrace>
					<!-- @{} defers interpolation until execution time so the JaCoCo
					     prepare-agent value (including the -javaagent flag) is used -->
					<argLine>@{argLine}</argLine>
				</configuration>
			</plugin>

			<!-- JaCoCo for code coverage -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<configuration>
					<excludes>
						<exclude>com/kratisai/controlplane/config/**/*</exclude>
						<!-- Hibernate enhance injects $$_hibernate_* methods into @Entity classes. -->
						<exclude>com/kratisai/controlplane/model/CanvasEntity.class</exclude>
						<exclude>com/kratisai/controlplane/model/ChatEntity.class</exclude>
						<exclude>com/kratisai/controlplane/model/ChatMemoryEntity.class</exclude>
						<exclude>com/kratisai/controlplane/model/ChatUsageSession.class</exclude>
						<exclude>com/kratisai/controlplane/model/CtxArchitecturePattern.class</exclude>
						<exclude>com/kratisai/controlplane/model/CtxDimension.class</exclude>
						<exclude>com/kratisai/controlplane/model/CtxEdge.class</exclude>
						<exclude>com/kratisai/controlplane/model/CtxEmbedding.class</exclude>
						<exclude>com/kratisai/controlplane/model/CtxNode.class</exclude>
						<exclude>com/kratisai/controlplane/model/CtxNodeDimension.class</exclude>
						<exclude>com/kratisai/controlplane/model/CtxWikiPage.class</exclude>
						<exclude>com/kratisai/controlplane/model/EnvironmentProvider.class</exclude>
						<exclude>com/kratisai/controlplane/model/ExecutionEnvironment.class</exclude>
						<exclude>com/kratisai/controlplane/model/IngestionBatch.class</exclude>
						<exclude>com/kratisai/controlplane/model/IngestionBatchLog.class</exclude>
						<exclude>com/kratisai/controlplane/model/KratisInstallation.class</exclude>
						<exclude>com/kratisai/controlplane/model/ModelProvider.class</exclude>
						<exclude>com/kratisai/controlplane/model/RefreshToken.class</exclude>
						<exclude>com/kratisai/controlplane/model/RepoCredential.class</exclude>
						<exclude>com/kratisai/controlplane/model/Repository.class</exclude>
						<exclude>com/kratisai/controlplane/model/SandboxExecution.class</exclude>
						<exclude>com/kratisai/controlplane/model/SandboxExecutionActivity.class</exclude>
						<exclude>com/kratisai/controlplane/model/SandboxPermissionRule.class</exclude>
						<exclude>com/kratisai/controlplane/model/ScratchpadEntity.class</exclude>
						<exclude>com/kratisai/controlplane/model/Team.class</exclude>
						<exclude>com/kratisai/controlplane/model/TeamMember.class</exclude>
						<exclude>com/kratisai/controlplane/model/User.class</exclude>
					</excludes>
					<rules>
						<rule>
							<element>BUNDLE</element>
							<limits>
								<limit>
									<counter>INSTRUCTION</counter>
									<value>COVEREDRATIO</value>
									<minimum>0.90</minimum>
								</limit>
								<limit>
									<counter>LINE</counter>
									<value>COVEREDRATIO</value>
									<minimum>0.90</minimum>
								</limit>
								<limit>
									<counter>BRANCH</counter>
									<value>COVEREDRATIO</value>
									<!-- 77% is current floor -->
									<minimum>0.75</minimum>
								</limit>
							</limits>
						</rule>
					</rules>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>test</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.github.svaningelgem</groupId>
				<artifactId>jacoco-console-reporter</artifactId>
				<version>1.3.2</version>
				<executions>
					<execution>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<showTree>false</showTree>
							<showFiles>false</showFiles>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Spotless for auto-formatting -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.2.0</version>
				<configuration>
					<java>
						<palantirJavaFormat/>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>validate</phase>
					</execution>
				</executions>
			</plugin>

			<!-- OpenRewrite for automated code refactoring and cleaning -->
			<plugin>
				<groupId>org.openrewrite.maven</groupId>
				<artifactId>rewrite-maven-plugin</artifactId>
				<version>6.40.0</version>
				<configuration>
					<activeRecipes>
						<recipe>org.openrewrite.staticanalysis.CommonStaticAnalysis</recipe>
					</activeRecipes>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.openrewrite.recipe</groupId>
						<artifactId>rewrite-static-analysis</artifactId>
						<version>2.35.0</version>
					</dependency>
				</dependencies>
			</plugin>

			<!-- Compiler plugin (Java 21) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>21</source>
					<target>21</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.hibernate.orm</groupId>
				<artifactId>hibernate-maven-plugin</artifactId>
				<version>7.0.2.Final</version>
				<executions>
					<execution>
						<id>enhance</id>
						<goals>
							<goal>enhance</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<enableAssociationManagement>false</enableAssociationManagement>
					<enableDirtyTracking>true</enableDirtyTracking>
					<enableExtendedEnhancement>false</enableExtendedEnhancement>
					<enableLazyInitialization>true</enableLazyInitialization>
					<fileSets>
						<fileSet>
							<directory>${project.build.directory}/classes</directory>
							<includes>
								<include>com/kratisai/controlplane/model/**/*.class</include>
							</includes>
						</fileSet>
					</fileSets>
				</configuration>
			</plugin>

			<!-- Checkstyle for code style enforcement -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
					<consoleOutput>false</consoleOutput>
					<failsOnError>true</failsOnError>
					<linkXRef>false</linkXRef>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>12.1.0</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>validate</phase>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>3.28.0</version>
				<configuration>
					<rulesets>
						<ruleset>pmd-ruleset.xml</ruleset>
					</rulesets>
					<includeTests>true</includeTests>
					<failOnViolation>true</failOnViolation>
					<printFailingErrors>true</printFailingErrors>
					<analysisCache>true</analysisCache>
					<analysisCacheLocation>${project.build.directory}/pmd/pmd.cache</analysisCacheLocation>
					<targetJdk>21</targetJdk>
					<excludes>
						<exclude>**/target/**</exclude>
						<exclude>**/generated-sources/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>process-test-classes</phase>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.10.3.0</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<includeTests>true</includeTests>
					<failOnError>true</failOnError>
					<excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>verify</phase>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- GraalVM Native Image profile - activate with: ./mvnw -Pnative native:compile -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<configuration>
							<buildArgs>
								<!-- Optimise for build-speed -->
								<buildArg>-Ob</buildArg>
								<!-- Optimise for size-->
								<!--<buildArg>-Os</buildArg>-->
								<!--
								  ── Resource caps ─────────────────────────────────────────────
								  By default native-image uses all available vCPUs and up to ~80%
								  of physical RAM. On a laptop or a constrained CI runner this
								  causes OOM kills and thrashing.

								  -J-Xmx caps the heap of the JVM that runs native-image itself.
								  8 g is sufficient for most Spring Boot apps compiled with -Ob.
								  Override with -Dnative.jvm.maxheap=Ng.
								-->
								<buildArg>--parallelism=${native.parallelism}</buildArg>
								<buildArg>-J-Xmx${native.jvm.maxheap}</buildArg>
								<!--
								  ── Safety net ────────────────────────────────────────────────
								  Without this flag, native-image silently falls back to a
								  regular JVM jar if compilation fails. That would produce a
								  working but enormous image that defeats the entire purpose of
								  the native build pipeline.
								-->
								<buildArg>--no-fallback</buildArg>
								<!--
								  ── OkHttp Kotlin companion-object workarounds ───────────────
								  OkHttp 4.x is a transitive dependency of spring-ai-anthropic,
								  spring-ai-openai, and spring-ai-google-genai (via the official
								  Anthropic/OpenAI Java SDKs and google-genai SDK).

								  OkHttp is written in Kotlin. Kotlin companion objects are
								  synthetic inner classes (e.g. Foo$Companion) whose static
								  initializers run lazily. GraalVM's static analysis completes
								  before these initializers fire, so the classes appear in the
								  image heap during Phase 8 (image writing) having never been
								  seen during Phase 2 (analysis) — causing the build to abort
								  with "image heap writing found a class not seen during static
								  analysis".

								  The fix is to defer initialization of the offending classes to
								  native binary startup (\-\-initialize\-at\-run\-time) rather than
								  letting them run during the native\-image build process.

								  RetryAndFollowUpInterceptor: confirmed failure in build log.
								  okhttp3.internal.platform: platform\-detection companions that
								  follow the same lazy\-init pattern and are likely the next
								  failure without this entry.
								-->
								<buildArg>--initialize-at-run-time=okhttp3.internal.http.RetryAndFollowUpInterceptor</buildArg>
								<buildArg>--initialize-at-run-time=okhttp3.internal.platform</buildArg>
								<!--
								  ── SQLite ProcessRunner build-time initialization ─────────────
								  sqlite-jdbc's OSInfo initializes static field processRunner at
								  build time during static analysis. GraalVM requires types with
								  objects in the image heap to be marked for build-time initialization.
								-->
								<buildArg>--initialize-at-build-time=org.sqlite.util.ProcessRunner</buildArg>
								<!-- 
								  ── Watchdog settings ──────────────────────────────────────────
								  Under high parallelism (e.g., 8 threads) and constrained heap (16g),
								  GC safepoint contention can stall JVMCI native calls (findLeastCommonAncestor)
								  long enough to trigger GraalVM's 10-minute deadlock watchdog.
								  We can disable this watchdog and the build might eventually recover.
								<buildArg>-H:-DeadlockWatchdogExitOnTimeout</buildArg>
								-->
							</buildArgs>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Error Prone profile - activate with: ./mvnw compile -Perror-prone -->
		<profile>
			<id>error-prone</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<source>21</source>
							<target>21</target>
							<fork>true</fork>
							<compilerArgs>
								<arg>-XDcompilePolicy=simple</arg>
								<arg>--should-stop=ifError=FLOW</arg>
								<arg>-Xplugin:ErrorProne -XepExcludedPaths:.*/generated-sources/.*</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
								<arg>--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
							</compilerArgs>
							<annotationProcessorPaths>
								<path>
									<groupId>com.google.errorprone</groupId>
									<artifactId>error_prone_core</artifactId>
									<version>${error-prone.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		
		<!-- Fast test profile - activate with: ./mvnw test -Pfast -->
		<profile>
			<id>fast</id>
			<properties>
				<!-- Coverage checks are skipped: a subset of tests would under-report
				     coverage. Full ./mvnw test / verify still enforce them. -->
				<jacoco.skip>true</jacoco.skip>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludedGroups>slow</excludedGroups>
							<systemPropertyVariables>
								<kratis.test.full-suite>false</kratis.test.full-suite>
							</systemPropertyVariables>
						</configuration>
					</plugin>
					<!-- Does not honour jacoco.skip and crashes on the missing exec data. -->
					<plugin>
						<groupId>io.github.svaningelgem</groupId>
						<artifactId>jacoco-console-reporter</artifactId>
						<executions>
							<execution>
								<id>default</id>
								<phase>none</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		
		<!-- Sequential test profile - activate with: ./mvnw test -Psequential -->
		<profile>
			<id>sequential</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
