{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitPushParams",
  "type": "object",
  "required": [
    "branchName"
  ],
  "properties": {
    "branchName": { "type": "string" },
    "commitMessage": { "type": "string" },
    "force": { "type": "boolean" },
    "squash": { "type": "boolean" },
    "targetBranch": { "type": "string" },
    "executionId": { "type": "string" }
  },
  "additionalProperties": false
}
