  "properties": {
    "sessionId": { "type": "string" },
    "stopReason": {
      "type": "string",
      "enum": ["end_turn", "max_tokens", "max_turn_requests", "refusal", "cancelled"]
    },
    "executionId": { "type": "string" }
  },
  "additionalProperties": false
}
