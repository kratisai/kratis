    "manifestDigest",
    "parts"
  ],
  "properties": {
    "executionId": {
      "type": "string"
    },
    "manifestDigest": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sha",
          "partIndex",
          "partCount",
          "data"
        ],
        "properties": {
          "sha": {
            "type": "string"
          },
          "partIndex": {
            "type": "integer"
          },
          "partCount": {
            "type": "integer"
          },
          "data": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
