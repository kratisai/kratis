{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecResult",
  "type": "object",
  "required": [
    "status",
    "exitCode"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed"
      ]
    },
    "exitCode": {
      "type": "integer"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
