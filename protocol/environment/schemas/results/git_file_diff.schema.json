{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitFileDiffResult",
  "type": "object",
  "required": [
    "path",
    "patch",
    "additions",
    "deletions",
    "totalLines"
  ],
  "properties": {
    "path": { "type": "string" },
    "patch": { "type": "string" },
    "additions": { "type": "integer" },
    "deletions": { "type": "integer" },
    "totalLines": { "type": "integer" }
  },
  "additionalProperties": false
}
