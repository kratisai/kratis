    ],
    "C4Context": [],
    "C4Container": [],
    "C4Component": [],
    "pie": [],
    "quadrantChart": [],
    "xychart-beta": [],
    "journey": []
  },
  "patterns": {
    "identifier": "^[A-Za-z][A-Za-z0-9_]*$",
    "flowIdentifier": "^[A-Za-z0-9_]+$",
    "number": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
    "coordinate": "^(?:0(?:\\.[0-9]+)?|1)$"
  },
  "bounds": {
    "maxInputUtf16Units": 100000,
    "maxDepth": 32,
    "journeyScoreMin": 1,
    "journeyScoreMax": 5
  }
}
