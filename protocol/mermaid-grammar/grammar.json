      "over",
      "par",
      "par_over",
      "participant",
      "properties",
      "rect",
      "sequencediagram",
      "title"
    ],
    "classDiagram": [
      "call",
      "callback",
      "class",
      "classdef",
      "classdiagram",
      "click",
      "cssclass",
      "href",
      "link",
      "namespace",
