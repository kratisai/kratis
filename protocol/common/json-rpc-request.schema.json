{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JsonRpcRequest",
  "type": "object",
  "required": ["jsonrpc", "method"],
  "properties": {
    "jsonrpc": {
      "type": "string",
      "const": "2.0"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": ["object", "array", "null"]
    },
    "id": {
      "type": ["string", "number", "null"]
    }
  },
  "additionalProperties": false
}
